# Copy to .env and fill in. Never commit .env.

# --- Mode -------------------------------------------------------------
# auto   = use Gemini if GEMINI_API_KEY is set, otherwise offline mode
# offline= deterministic stand-ins (hashing embedder + extractive reasoner); no network
# gemini = require Gemini
EKA_MODE=auto
GEMINI_API_KEY=
# Model names change often. Check https://ai.google.dev/gemini-api/docs/models before use.
GEMINI_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# --- Runtime ----------------------------------------------------------
# pipeline = deterministic orchestration with a swappable reasoner (default, used by eval)
# adk      = Google ADK multi-agent runtime (needs GEMINI_API_KEY)
AGENT_RUNTIME=pipeline

# --- Data and storage ---------------------------------------------------
EKA_DATA_DIR=./data
# memory | qdrant
VECTOR_BACKEND=memory
QDRANT_URL=
QDRANT_API_KEY=

# --- Source -------------------------------------------------------------
# local = synthetic corpus in EKA_DATA_DIR/corpus (default)
# drive = Google Drive folder (needs OAuth token, see docs/SETUP_GOOGLE.md)
SOURCE=local
DRIVE_FOLDER_ID=
COMPANY_DOMAIN=northwind.example
ALLOWED_RECIPIENT_DOMAINS=northwind.example

# --- Actions ------------------------------------------------------------
# outbox = write approved actions to data/outbox/*.json (safe demo default)
# google = create Gmail DRAFTS and Calendar events (needs OAuth token)
ACTION_BACKEND=outbox

# --- Auth ---------------------------------------------------------------
# DEMO_AUTH=1 lets you pick a demo user in the UI. Turn OFF when deployed publicly.
DEMO_AUTH=1
SESSION_SECRET=change-me-to-a-long-random-string
GOOGLE_OAUTH_CLIENT_ID=
MAX_REQUESTS_PER_MINUTE=30
